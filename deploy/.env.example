# Values of the test server. Copy to /opt/gridflow/.env on the VPS and fill in the blanks.
# Replace grid.example.com with the real domain everywhere.

# --- Stack ---
IMAGE_TAG=latest
# GitHub user or org that owns the GHCR packages, in lowercase.
GHCR_NAMESPACE=maiconcabral
# Network shared only by Nginx Proxy Manager and grid-router (see README: "Rede dedicada").
NPM_NETWORK=grid_proxy
MYSQL_ROOT_PASSWORD=!root2026@gridflow987xpto

# --- Laravel ---
APP_NAME=GridFlow
APP_ENV=production
APP_KEY=base64:gCoK4joVd9SbwhV9Gce7XtwwBR1Lj77k7cq+jGOpkgI=
APP_DEBUG=false
APP_URL=https://gridflow.maiconcabral.com.br
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=America/Sao_Paulo

# Behind Nginx Proxy Manager and the router. The app also trusts every proxy in code.
TRUSTED_PROXIES=*

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=grid_flow
DB_USERNAME=grid
DB_PASSWORD=!gridflowAppUSER2026@

QUEUE_CONNECTION=database
CACHE_STORE=database
# Covers, articles and briefings live on this disk and are served at /storage.
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log
LOG_CHANNEL=stderr
LOG_LEVEL=info

# The test server does not send real e-mail; messages go to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=nao-responda@grid.example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Next.js ---
# Baked into the web image at build time. Must be the public origin, with https://.
NEXT_PUBLIC_API_URL=https://gridflow.maiconcabral.com.br
